<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Planner.Client.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <UserControl.Styles>
        <!--
            Navigation rows are 22px full-bleed strips, not floating pills: no corner radius, no
            margin, no gap between them. That is what makes a tree read as a tree.
        -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppForeground}" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
        </Style>

        <Style Selector="Button.tool controls|Icon">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Pixel-width so the splitter has something to drag; the code-behind collapses it to
                 zero for Ctrl+B and puts the dragged width back on the way out. -->
            <ColumnDefinition Width="216" MinWidth="150" MaxWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation. Width is a drag away; Ctrl+B collapses it entirely. -->
        <Border Grid.Column="0"
                x:Name="Sidebar"
                IsVisible="{Binding IsSidebarVisible}"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0" Padding="6,6,6,6">
                    <ComboBox ItemsSource="{Binding Teams}"
                              SelectedItem="{Binding SelectedTeam}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="Switch team">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="contracts:TeamDto">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding Color, Converter={StaticResource HexBrush}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,0,0">
                    <StackPanel>

                        <ItemsControl ItemsSource="{Binding PrimaryNav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItemViewModel">
                                    <Button Classes="nav"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="2,Auto,*" ColumnSpacing="0" Height="22">
                                            <!-- The marker a native list uses for the current item. -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding IsSelected}" />
                                            <controls:Icon Grid.Column="1" Data="{Binding Icon}" Size="14"
                                                           Margin="8,0,7,0"
                                                           Foreground="{DynamicResource MutedForeground}"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="PROJECTS"
                                   Classes="caption"
                                   FontSize="10"
                                   Margin="10,14,0,4"
                                   IsVisible="{Binding HasProjects}" />

                        <ItemsControl ItemsSource="{Binding ProjectNav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItemViewModel">
                                    <Button Classes="nav"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SelectCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding Title}">
                                        <Grid ColumnDefinitions="2,Auto,*" Height="22">
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    IsVisible="{Binding IsSelected}" />
                                            <Ellipse Grid.Column="1" Width="7" Height="7"
                                                     Margin="12,0,10,0"
                                                     Fill="{Binding AccentColor, Converter={StaticResource HexBrush}}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Who am I, and the way out -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="{Binding UserInitials}" FontSize="10"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppForeground}" />
                            <TextBlock Text="{Binding UserRole}" FontSize="10"
                                       Foreground="{DynamicResource MutedForeground}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="tool"
                                Command="{Binding SignOutCommand}"
                                Padding="4,2"
                                ToolTip.Tip="Sign out">
                            <controls:Icon Data="{Binding SignOutIcon}" Size="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      x:Name="SidebarSplitter"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsSidebarVisible}" />

        <!-- Content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <!-- Toolbar strip: the view's name on the left, its actions on the right, 30px tall. -->
            <Border Grid.Row="0"
                    Height="31"
                    Background="{DynamicResource ChromeBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="9,0">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="7">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ContentTitle}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ContentSubtitle}"
                               IsVisible="{Binding ContentSubtitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForeground}" />

                    <Button Grid.Column="3" Classes="tool"
                            Command="{Binding NewIssueCommand}"
                            ToolTip.Tip="New issue (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:Icon Data="{Binding PlusIcon}" Size="14" VerticalAlignment="Center" />
                            <TextBlock Text="New Issue" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="4" Width="1" Height="16"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center" />

                    <Button Grid.Column="5" Classes="tool"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Refresh (F5)">
                        <controls:Icon Data="{Binding RefreshIcon}" Size="14" />
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Content}" />
        </Grid>
    </Grid>
</UserControl>
