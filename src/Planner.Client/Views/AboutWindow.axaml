<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Planner.Client.Views.AboutWindow"
             x:DataType="vm:ShellViewModel"
             Icon="/Assets/planner.ico"
             Title="About Planner"
             Width="360" SizeToContent="Height"
             CanResize="False"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             LogoVisibility="Never"
             IsMinimizeCaptionButtonVisible="False"
             IsMaximizeCaptionButtonVisible="False">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="18,16" Spacing="4">
            <TextBlock Text="Planner" FontSize="{atom:SharedTokenResource FontSizeHeading5}" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                       Classes="caption" />
            <TextBlock Text="Issue tracking for teams." Classes="caption" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <atom:Button Content="OK"
                         ButtonType="Primary"
                         Click="OnCloseClick"
                         IsDefault="True"
                         IsCancel="True"
                         MinWidth="80"
                         HorizontalAlignment="Right"
                         HorizontalContentAlignment="Center" />
        </Border>
    </Grid>
</atom:Window>
