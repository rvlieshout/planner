<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:views="using:Planner.Client.Views"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="540"
             x:Class="Planner.Client.Views.IssueEditorWindow"
             x:DataType="vm:IssueEditorViewModel"
             Icon="/Assets/planner.ico"
             Title="{Binding WindowTitle}"
             Width="620" Height="540"
             MinWidth="520" MinHeight="420"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             LogoVisibility="Never"
             IsMinimizeCaptionButtonVisible="False">

    <views:IssueFormView />
</atom:Window>
