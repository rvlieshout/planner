<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Planner.Client.Views.ConfirmWindow"
             Icon="/Assets/planner.ico"
             Width="400" SizeToContent="Height"
             CanResize="False"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             LogoVisibility="Never"
             IsMinimizeCaptionButtonVisible="False"
             IsMaximizeCaptionButtonVisible="False">

    <Grid RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0" Margin="18,16" Spacing="6">
            <TextBlock x:Name="Headline"
                       FontSize="{atom:SharedTokenResource FontSizeHeading5}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="Detail" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <!--
            The safe answer is the default one. Enter and Escape both fall to the button that changes
            nothing, so dismissing this dialog the way people dismiss dialogs — without reading it —
            keeps the work rather than throwing it away.
        -->
        <Border Grid.Row="1"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                <atom:Button x:Name="ConfirmButton"
                             IsDanger="True"
                             Click="OnConfirmClick"
                             MinWidth="96"
                             HorizontalContentAlignment="Center" />
                <atom:Button x:Name="CancelButton"
                             ButtonType="Primary"
                             Click="OnCancelClick"
                             IsDefault="True"
                             IsCancel="True"
                             MinWidth="96"
                             HorizontalContentAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</atom:Window>
