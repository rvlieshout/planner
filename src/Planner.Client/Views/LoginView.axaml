<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Planner.Client.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- A connection dialog, not a landing page: one bordered panel of fields, labels in their own
         column, and the default button bottom-right. -->
    <Border Width="340"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <Grid RowDefinitions="Auto,Auto,Auto">

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,7">
                <TextBlock Text="Sign in to Planner" FontSize="12"
                           Foreground="{DynamicResource AppForeground}" />
            </Border>

            <Grid Grid.Row="1" Margin="12"
                  ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="7">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding ServerUrl}"
                         PlaceholderText="http://planner.internal:8080"
                         IsEnabled="{Binding !IsBusy}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Email}"
                         PlaceholderText="you@company.local"
                         IsEnabled="{Binding !IsBusy}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Password}"
                         PasswordChar="●"
                         IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,9">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <ProgressBar Grid.Column="0"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"
                                     Height="2"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Sign in"
                                Classes="accent"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                IsDefault="True"
                                MinWidth="84"
                                HorizontalContentAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="4"
                                IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Error}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource DangerBrush}" />

                        <!-- The reason the update banner is not gated on being signed in: if this version is
                             the problem, this hint is the only route out of it. -->
                        <TextBlock IsVisible="{Binding ShowUpdateHint}"
                                   Text="An update is ready to install. If sign-in stopped working after an upgrade, installing it may fix this."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedForeground}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
