<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Planner.Client.Views.BoardView"
             x:DataType="vm:BoardViewModel">

    <UserControl.Styles>
        <!-- The column being dragged over says so, so a drop is never a guess. -->
        <Style Selector="Border.column.dropTarget">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
        </Style>

        <!-- A label is a 2px-cornered tag, not a pill: the same shape the rest of the window uses. -->
        <Style Selector="Border.label">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Columns}" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoardColumnViewModel">
                        <Border Width="262"
                                Classes="column"
                                Classes.dropTarget="{Binding IsDropTarget}"
                                Background="{DynamicResource ColumnBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid RowDefinitions="Auto,*">

                                <!-- Column header, 24px, with the count where a native list puts it. -->
                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Height="24"
                                        Padding="7,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Color, Converter={StaticResource HexBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppForeground}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedForeground}" />
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Issues}"
                                         ItemContainerTheme="{StaticResource DenseRow}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="4"
                                         SelectionMode="Single"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         DoubleTapped="OnRowActivated"
                                         KeyDown="OnRowKeyDown"
                                         ContextRequested="OnContextRequested"
                                         DragDrop.AllowDrop="True"
                                         DragDrop.DragOver="OnColumnDragOver"
                                         DragDrop.DragLeave="OnColumnDragLeave"
                                         DragDrop.Drop="OnColumnDrop">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Open" InputGesture="Enter"
                                                      Click="OnOpenClick" />
                                            <MenuItem Header="_Copy Issue Key" Click="OnCopyKeyClick" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IssueCardViewModel">
                                            <Border Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Margin="0,0,0,3"
                                                    Padding="6,4"
                                                    ToolTip.Tip="{Binding UpdatedTooltip}">
                                                <StackPanel Spacing="3">

                                                    <!-- Metadata line: identifier, priority, size. -->
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                                          ColumnSpacing="5">
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                                   Classes="key"
                                                                   VerticalAlignment="Center" />
                                                        <controls:Icon Grid.Column="1"
                                                                       Data="{Binding PriorityIcon}"
                                                                       Size="13"
                                                                       IsVisible="{Binding HasPriority}"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding PriorityLabel}"
                                                                       Foreground="{Binding PriorityColor, Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding EstimateLabel}"
                                                                   IsVisible="{Binding HasEstimate}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="Estimate"
                                                                   Foreground="{DynamicResource MutedForeground}" />
                                                        <Border Grid.Column="4"
                                                                Width="16" Height="16"
                                                                CornerRadius="2"
                                                                IsVisible="{Binding AssigneeInitials, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                Background="{DynamicResource AccentBrush}"
                                                                ToolTip.Tip="{Binding AssigneeName}">
                                                            <TextBlock Text="{Binding AssigneeInitials}"
                                                                       FontSize="9"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Title}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppForeground}" />

                                                    <ItemsControl ItemsSource="{Binding Labels}"
                                                                  IsVisible="{Binding HasLabels}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="contracts:LabelDto">
                                                                <Border Classes="label"
                                                                        BorderBrush="{Binding Color, Converter={StaticResource HexBrush}}">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="10"
                                                                               Foreground="{Binding Color, Converter={StaticResource HexBrush}}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     VerticalAlignment="Top"
                     Height="2" />

        <TextBlock IsVisible="{Binding IsEmpty}"
                   Text="No issues. Ctrl+N creates one."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource MutedForeground}" />

        <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="{DynamicResource DangerBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="9,5">
            <TextBlock Text="{Binding Error}" FontSize="11"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>
    </Panel>
</UserControl>
