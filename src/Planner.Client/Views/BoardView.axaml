<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Planner.Client.Views.BoardView"
             x:DataType="vm:BoardViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <!--
            What a drag looks like, in four parts.

            A drop is a guess until the board answers three questions: what am I carrying, where would it
            land, and would this column take it. The ghost under the cursor answers the first, the rule
            inside a column answers the second, and the outline and fill answer the third. The fourth
            part is the row left behind, which steps back so the ghost is the thing being followed.

            The third answer is drawn in two places because a lane can hold more than one column: the
            lane outlines, and the column inside it fills. In a lane with one column — most of them —
            those are the same rectangle and it reads exactly as it always did.

            Note that the resting appearance of a lane and of a card is set here rather than on the
            elements themselves. It has to be: a value written on the element is a local value, and a
            local value outranks every Style setter, including the drag states below — so a lane with
            Background="..." on it can never be lit up by a class.
        -->

        <!-- 1a. The lane, and the lane that would take the drop. -->
        <Style Selector="Border.lane">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgLayout}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.lane.dropTarget">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>

        <!-- 1b. The column inside it, and the column the card would land in. Transparent at rest, so
             the lane it sits in is what shows through.

             ColorPrimaryBg — the token this would normally reach for — is paler than the white cards
             sitting on the column, so lighting a column made it look emptier rather than chosen. One
             step up the ramp is the first tint that reads as a highlight against a grey lane. The
             radius matches the lane's, which is what keeps the fill inside its rounded corners. -->
        <Style Selector="Border.column">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.column.dropTarget">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryBgHover}" />
        </Style>

        <!-- 2. The gap the card would land in. Only ever drawn on the column under the cursor, so
             there is exactly one of these on screen at a time. -->
        <Style Selector="Border.dropLine">
            <Setter Property="Height" Value="2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>

        <!-- 3. The card, and the card that was picked up. Faded and stripped of its fill: still there,
             holding its place, but no longer the thing being moved. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainer}" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorderSecondary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card.dragging">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimaryBorder}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <atom:ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lanes}" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BoardLaneViewModel">
                        <Border Width="262"
                                Classes="lane"
                                Classes.dropTarget="{Binding IsDropTarget}">

                            <!-- One row per column, of equal height. Equal rather than sized to their
                                 contents: both halves of a shared lane have to stay on screen, or the
                                 drag that promotes work out of the backlog has nowhere to go. -->
                            <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BoardColumnViewModel">
                                        <Border Classes="column"
                                                Classes.dropTarget="{Binding IsDropTarget}">
                                            <Grid RowDefinitions="Auto,Auto,*">

                                                <!-- What separates one column from the
                                                     next one down. The top one of a lane
                                                     has the lane's own border above it
                                                     and draws nothing. -->
                                                <Border Grid.Row="0" Height="1"
                                                        IsVisible="{Binding !IsFirstInLane}"
                                                        Background="{atom:SharedTokenResource ColorBorderSecondary}" />

                                                <!-- Column header, 24px, with the count
                                                     where a native list puts it. -->
                                                <Border Grid.Row="1"
                                                        BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                                        BorderThickness="0,0,0,1"
                                                        Height="24"
                                                        Padding="7,0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding Color, Converter={StaticResource HexBrush}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                                   FontSize="{atom:SharedTokenResource FontSizeSM}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                                    </Grid>
                                                </Border>

                                                <!-- The list, and the rule drawn over it.
                                                     The rule is a sibling rather than an
                                                     item so it can sit between two rows
                                                     without being one. -->
                                                <Panel Grid.Row="2">
                                                    <atom:ListBox Classes="dense cards"
                                                                  ItemsSource="{Binding Issues}"
                                                                  Padding="4"
                                                                  SelectionMode="Single"
                                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                  DoubleTapped="OnRowActivated"
                                                                  KeyDown="OnRowKeyDown"
                                                                  ContextRequested="OnContextRequested"
                                                                  DragDrop.AllowDrop="True"
                                                                  DragDrop.DragOver="OnColumnDragOver"
                                                                  DragDrop.DragLeave="OnColumnDragLeave"
                                                                  DragDrop.Drop="OnColumnDrop">
                                                        <atom:ListBox.ContextMenu>
                                                            <atom:ContextMenu>
                                                                <atom:MenuItem Header="_Open" InputGesture="Enter"
                                                                               Click="OnOpenClick" />
                                                                <atom:MenuItem Header="_Copy Issue Key" Click="OnCopyKeyClick" />
                                                            </atom:ContextMenu>
                                                        </atom:ListBox.ContextMenu>

                                                        <atom:ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:IssueCardViewModel">
                                                                <Border Classes="card"
                                                                        Classes.dragging="{Binding IsDragging}"
                                                                        atom:ToolTip.Tip="{Binding UpdatedTooltip}">
                                                                    <StackPanel Spacing="3">

                                                                        <!-- Metadata line: identifier,
                                                                             priority, size. -->
                                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                                                              ColumnSpacing="5">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                                                       Classes="key"
                                                                                       VerticalAlignment="Center" />
                                                                            <controls:Icon Grid.Column="1"
                                                                                           Data="{Binding PriorityIcon}"
                                                                                           Size="13"
                                                                                           IsVisible="{Binding HasPriority}"
                                                                                           VerticalAlignment="Center"
                                                                                           atom:ToolTip.Tip="{Binding PriorityLabel}"
                                                                                           Foreground="{Binding PriorityColor, Converter={StaticResource HexBrush}}" />
                                                                            <TextBlock Grid.Column="3"
                                                                                       Text="{Binding EstimateLabel}"
                                                                                       IsVisible="{Binding HasEstimate}"
                                                                                       FontSize="{atom:SharedTokenResource FontSizeSM}"
                                                                                       VerticalAlignment="Center"
                                                                                       atom:ToolTip.Tip="Estimate"
                                                                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                                                            <atom:Avatar Grid.Column="4"
                                                                                         Classes="xs"
                                                                                         Shape="Square"
                                                                                         Text="{Binding AssigneeInitials}"
                                                                                         IsVisible="{Binding AssigneeInitials, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                                         atom:ToolTip.Tip="{Binding AssigneeName}" />
                                                                        </Grid>

                                                                        <TextBlock Text="{Binding Title}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxLines="2"
                                                                                   TextTrimming="CharacterEllipsis" />

                                                                        <ItemsControl ItemsSource="{Binding Labels}"
                                                                                      IsVisible="{Binding HasLabels}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="contracts:LabelDto">
                                                                                    <atom:Tag Text="{Binding Name}"
                                                                                              TagColor="{Binding Color}"
                                                                                              Variant="Outlined"
                                                                                              Margin="0,0,3,0" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </atom:ListBox.ItemTemplate>
                                                    </atom:ListBox>

                                                    <Border Classes="dropLine"
                                                            IsVisible="{Binding IsDropTarget}"
                                                            Margin="{Binding DropIndicatorMargin}" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </atom:ScrollViewer>

        <atom:ProgressBar IsIndeterminate="True"
                          IsVisible="{Binding IsLoading}"
                          IsProgressInfoVisible="False"
                          VerticalAlignment="Top" />

        <TextBlock IsVisible="{Binding IsEmpty}"
                   Text="No issues. Ctrl+N creates one."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{atom:SharedTokenResource ColorTextSecondary}" />

        <atom:Alert IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Type="Error"
                    Message="{Binding Error}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
    </Panel>
</UserControl>
