<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:auth="using:Planner.Contracts.Auth"
             x:Class="Planner.Client.Views.UsersView"
             x:DataType="vm:UsersViewModel">
    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="10">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Error}" Foreground="{atom:SharedTokenResource ColorError}"
                       TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="Loading / saving…" Classes="caption" IsVisible="{Binding IsLoading}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="240,*" ColumnSpacing="16" IsEnabled="{Binding !IsLoading}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <atom:Button Content="New user" Command="{Binding NewUserCommand}" HorizontalAlignment="Stretch" />
                <atom:LineEdit Grid.Row="1" Text="{Binding Search}" PlaceholderText="Search name or email" />
                <atom:ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="auth:UserSummary">
                                <atom:Button ButtonType="Text" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                             Command="{Binding $parent[UserControl].((vm:UsersViewModel)DataContext).SelectUserCommand}"
                                             CommandParameter="{Binding}" Padding="6" Margin="0,0,0,2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Inactive" Classes="caption" IsVisible="{Binding !IsActive}" />
                                    </StackPanel>
                                </atom:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </atom:ScrollViewer>
                <TextBlock Grid.Row="3" Text="{Binding StatusSummary}" Classes="caption" />
            </Grid>
            <TextBlock Grid.Column="1" Text="Select a user or create an account to manage access."
                       IsVisible="{Binding !HasEditor}" TextWrapping="Wrap" Margin="0,8" />
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10" IsVisible="{Binding HasEditor}">
                <atom:ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" MaxWidth="850" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" FontSize="18" />
                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <TextBlock Text="Display name" VerticalAlignment="Center" />
                            <atom:LineEdit Grid.Column="1" Text="{Binding DisplayName}" />
                            <TextBlock Grid.Row="1" Text="Email" VerticalAlignment="Center" />
                            <atom:LineEdit Grid.Row="1" Grid.Column="1" Text="{Binding Email}" IsEnabled="{Binding IsNew}" />
                            <TextBlock Grid.Row="2" Text="Time zone" VerticalAlignment="Center" />
                            <atom:LineEdit Grid.Row="2" Grid.Column="1" Text="{Binding TimeZone}" PlaceholderText="Europe/Amsterdam" />
                            <TextBlock Grid.Row="3" Text="Organisation role" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <atom:ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                               HorizontalAlignment="Stretch" IsVisible="{Binding CanChangeRole}" />
                                <TextBlock Text="owner — only an owner can change this role" IsVisible="{Binding !CanChangeRole}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="Account" VerticalAlignment="Center" />
                            <atom:CheckBox Grid.Row="4" Grid.Column="1" Content="Active" IsChecked="{Binding IsActive}" IsEnabled="{Binding CanChangeActive}" />
                        </Grid>
                        <TextBlock Text="{Binding RoleDescription}" TextWrapping="Wrap" Classes="caption" />
                        <TextBlock Text="Owners and your own account cannot be deactivated. Inactive accounts keep their authored content."
                                   TextWrapping="Wrap" Classes="caption" />
                        <atom:Separator />
                        <TextBlock Text="Teams and rights" FontWeight="SemiBold" />
                        <TextBlock Text="Choose a membership role for each team. Changes are applied when you save."
                                   TextWrapping="Wrap" Classes="caption" />
                        <Grid ColumnDefinitions="*,140,160" ColumnSpacing="8">
                            <TextBlock Text="Team" Classes="caption" />
                            <TextBlock Grid.Column="1" Text="Membership" Classes="caption" />
                            <TextBlock Grid.Column="2" Text="Effective access" Classes="caption" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Teams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserTeamRow">
                                    <Grid ColumnDefinitions="*,140,160" ColumnSpacing="8" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <atom:ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selection}" HorizontalAlignment="Stretch" />
                                        <TextBlock Grid.Column="2" Text="{Binding EffectiveAccess}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <atom:Separator />
                        <TextBlock Text="Password" FontWeight="SemiBold" />
                        <TextBlock Text="At least 12 characters. Required for a new account. For an existing account, use Reset password separately."
                                   TextWrapping="Wrap" Classes="caption" />
                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <TextBlock Text="New password" VerticalAlignment="Center" />
                            <atom:LineEdit Grid.Column="1" Text="{Binding Password}" PasswordChar="●" />
                            <TextBlock Grid.Row="1" Text="Confirm password" VerticalAlignment="Center" />
                            <atom:LineEdit Grid.Row="1" Grid.Column="1" Text="{Binding PasswordConfirmation}" PasswordChar="●" />
                        </Grid>
                        <atom:Button Content="Reset password" Command="{Binding ResetPasswordCommand}"
                                     IsVisible="{Binding IsExisting}" HorizontalAlignment="Right" />
                    </StackPanel>
                </atom:ScrollViewer>
                <atom:Button Grid.Row="1" Content="Save user &amp; team access" ButtonType="Primary"
                             Command="{Binding SaveCommand}" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
