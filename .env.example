# Copy to .env before the first `docker compose up`.

# --- Database -------------------------------------------------------------
POSTGRES_DB=planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
PLANNER_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Protects the token signing/encryption certificates stored on the keys volume.
# Changing it after first start makes existing certificates unreadable.
PLANNER_KEY_PASSWORD=change-me-keys

# Bootstrap owner, created on first start. Minimum 12 characters.
PLANNER_OWNER_EMAIL=owner@planner.local
PLANNER_OWNER_NAME=Planner Owner
PLANNER_OWNER_PASSWORD=change-me-owner-password

# Fills an empty database with a sample team, project, milestones and issues.
PLANNER_SEED_DEMO=false

# Browser origin allowed to call the API. The Avalonia client does not need this.
PLANNER_ALLOWED_ORIGIN=http://localhost:8080

# --- pgAdmin (docker compose --profile tools up -d) -----------------------
PGADMIN_EMAIL=admin@planner.local
PGADMIN_PASSWORD=change-me-pgadmin
PGADMIN_PORT=5050
