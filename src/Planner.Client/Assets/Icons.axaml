    <StreamGeometry x:Key="IconTriangleAlert">M21.73,18 l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3 M12 9v4 M12 17h.01</StreamGeometry>
    <StreamGeometry x:Key="IconUsers">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M16 3.128a4 4 0 0 1 0 7.744 M22 21v-2a4 4 0 0 0-3-3.87 M5,7a4,4 0 1,0 8,0a4,4 0 1,0 -8,0</StreamGeometry>
</ResourceDictionary>
