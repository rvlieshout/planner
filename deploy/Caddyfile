# Internal web server. Public TLS, certificates and routing into this container are Coolify's job;
# this only decides what belongs to the website and what belongs to the API.
:80 {
    # Astro's output. Everything else — auth, SignalR, /updates, /health, /scalar and any path added
    # to the API later — falls through to the API without needing a rule here.
    @website path / /index.html /favicon.svg /_astro/*
    handle @website {
        root * /srv/site
        file_server
    }
    handle {
        reverse_proxy api:8080
    }
}
