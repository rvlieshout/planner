# Internal web server. Public TLS, certificates and routing into this container are Coolify's job;
# this only decides what belongs to the website, what belongs to the web client, and what belongs to
# the API.
#
# Serving the client from the same origin as the API is the whole trick behind how simple the client
# is: /api/v1, /connect/token and /hubs/planner are same-origin paths, so there is no CORS to
# configure, no origin list to keep in step with a domain, and no second hostname to certificate.
:80 {
    encode zstd gzip

    # Bare /app, so a link shared without the trailing slash still works.
    @app-root path /app
    redir @app-root /app/ 308

    # The SvelteKit client. Everything under /app is either a file it built or a route that exists
    # only in the browser, which is what try_files answers with the shell.
    @app path /app/*
    handle @app {
        root * /srv

        # Content-hashed filenames: safe to cache for a year, and they have to be, or every deploy
        # re-downloads the fonts and the whole bundle.
        @immutable path /app/_app/immutable/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # The shell is not hashed and must not be cached, or a deploy reaches nobody until their
        # browser decides to look again.
        @shell not path /app/_app/immutable/*
        header @shell Cache-Control "no-cache"

        try_files {path} /app/index.html
        file_server {
            precompressed br gzip
        }
    }

    # Astro's output. Everything else — auth, SignalR, /updates, /health, /scalar and any path added
    # to the API later — falls through to the API without needing a rule here.
    @website path / /index.html /favicon.svg /_astro/*
    handle @website {
        root * /srv/site
        file_server
    }

    handle {
        reverse_proxy api:8080
    }
}
