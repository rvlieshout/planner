<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Planner.Client.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <UserControl.Styles>
        <!--
            Navigation rows are 22px full-bleed strips, not floating pills: no corner radius, no
            margin, no gap between them. That is what makes a tree read as a tree, and it is the one
            place the app overrides AtomUI's button metrics outright rather than picking a variant.
        -->
        <Style Selector="atom|Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="atom|Button.nav.selected">
            <Setter Property="CustomBackground" Value="{atom:SharedTokenResource ControlItemBgActive}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- Pixel-width so the splitter has something to drag; the code-behind collapses it to
                 zero for Ctrl+B and puts the dragged width back on the way out. -->
            <ColumnDefinition Width="216" MinWidth="150" MaxWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation. Width is a drag away; Ctrl+B collapses it entirely. -->
        <Border Grid.Column="0"
                x:Name="Sidebar"
                IsVisible="{Binding IsSidebarVisible}"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0" Padding="6">
                    <atom:ComboBox ItemsSource="{Binding Teams}"
                                   SelectedItem="{Binding SelectedTeam}"
                                   HorizontalAlignment="Stretch"
                                   atom:ToolTip.Tip="Switch team">
                        <atom:ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="contracts:TeamDto">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding Color, Converter={StaticResource HexBrush}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </atom:ComboBox.ItemTemplate>
                    </atom:ComboBox>
                </Border>

                <atom:ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,2,0,0">
                    <StackPanel>

                        <atom:Button Classes="nav" Classes.selected="{Binding IsUsersSelected}"
                                     ButtonType="Text" Command="{Binding ManageUsersCommand}"
                                     IsVisible="{Binding CanManageUsers}" Padding="10,4" Content="Users &amp; access" />

                        <!-- Above the team's own views, with the users entry: both are about the
                             organisation rather than about the team currently selected, and both are
                             reachable on an installation that has no teams yet. -->
                        <atom:Button Classes="nav" Classes.selected="{Binding IsTeamsSelected}"
                                     ButtonType="Text" Command="{Binding ManageTeamsCommand}"
                                     IsVisible="{Binding CanManageTeams}" Padding="10,4" Content="Teams" />

                        <ItemsControl ItemsSource="{Binding PrimaryNav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItemViewModel">
                                    <atom:Button Classes="nav"
                                                 Classes.selected="{Binding IsSelected}"
                                                 ButtonType="Text"
                                                 Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SelectCommand}"
                                                 CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="2,Auto,*" Height="22">
                                            <!-- The marker a native list uses for the current item. -->
                                            <Border Grid.Column="0"
                                                    Background="{atom:SharedTokenResource ColorPrimary}"
                                                    IsVisible="{Binding IsSelected}" />
                                            <controls:Icon Grid.Column="1" Data="{Binding Icon}" Size="14"
                                                           Margin="8,0,7,0"
                                                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                           VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </atom:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Always shown, projects or not: the ＋ beside it is how the first one gets
                             made, and a section that only appears once you have one cannot say that. -->
                        <Grid ColumnDefinitions="*,Auto" Margin="10,14,4,4">
                            <TextBlock Grid.Column="0" Text="PROJECTS" Classes="caption"
                                       VerticalAlignment="Center" />
                            <atom:Button Grid.Column="1" Classes="tool"
                                         ButtonType="Text"
                                         Padding="3,0"
                                         MinHeight="16"
                                         Command="{Binding NewProjectCommand}"
                                         atom:ToolTip.Tip="New project (Ctrl+Shift+N)">
                                <controls:Icon Data="{Binding PlusIcon}" Size="13" />
                            </atom:Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ProjectNav}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItemViewModel">
                                    <atom:Button Classes="nav"
                                                 Classes.selected="{Binding IsSelected}"
                                                 ButtonType="Text"
                                                 Command="{Binding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SelectCommand}"
                                                 CommandParameter="{Binding}"
                                                 atom:ToolTip.Tip="{Binding Title}">
                                        <Grid ColumnDefinitions="2,Auto,*" Height="22">
                                            <Border Grid.Column="0"
                                                    Background="{atom:SharedTokenResource ColorPrimary}"
                                                    IsVisible="{Binding IsSelected}" />
                                            <Ellipse Grid.Column="1" Width="7" Height="7"
                                                     Margin="12,0,10,0"
                                                     Fill="{Binding AccentColor, Converter={StaticResource HexBrush}}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </atom:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </atom:ScrollViewer>

                <!-- Who am I, and the way out -->
                <Border Grid.Row="2"
                        BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                        BorderThickness="0,1,0,0"
                        Padding="8,5">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <atom:Avatar Grid.Column="0"
                                     Classes="sm"
                                     Shape="Square"
                                     Text="{Binding UserInitials}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRole}" Classes="caption" />
                        </StackPanel>
                        <atom:Button Grid.Column="2" Classes="tool"
                                     ButtonType="Text"
                                     Command="{Binding SignOutCommand}"
                                     Padding="4,2"
                                     atom:ToolTip.Tip="Sign out">
                            <controls:Icon Data="{Binding SignOutIcon}" Size="14" />
                        </atom:Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      x:Name="SidebarSplitter"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsSidebarVisible}" />

        <!-- Content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">

            <!-- Toolbar strip: the view's name on the left, its actions on the right, 31px tall. -->
            <Border Grid.Row="0"
                    Height="31"
                    Background="{atom:SharedTokenResource ColorBgLayout}"
                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                    BorderThickness="0,0,0,1"
                    Padding="9,0">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="7">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ContentTitle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ContentSubtitle}"
                               IsVisible="{Binding ContentSubtitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Classes="caption"
                               VerticalAlignment="Center" />

                    <!-- Only reachable while a project is the thing on screen, which is also the only
                         time it means anything. -->
                    <atom:Button Grid.Column="2" Classes="tool"
                                 ButtonType="Text"
                                 HorizontalAlignment="Right"
                                 Command="{Binding EditProjectCommand}"
                                 IsVisible="{Binding IsProjectSelected}"
                                 atom:ToolTip.Tip="Project settings and milestones">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:Icon Data="{Binding SettingsIcon}" Size="14" VerticalAlignment="Center" />
                            <TextBlock Text="Project" VerticalAlignment="Center" />
                        </StackPanel>
                    </atom:Button>

                    <atom:Button Grid.Column="3" Classes="tool"
                                 ButtonType="Text"
                                 Command="{Binding NewIssueCommand}"
                                 atom:ToolTip.Tip="New issue (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:Icon Data="{Binding PlusIcon}" Size="14" VerticalAlignment="Center" />
                            <TextBlock Text="New Issue" VerticalAlignment="Center" />
                        </StackPanel>
                    </atom:Button>

                    <atom:Separator Grid.Column="4" Orientation="Vertical" Height="16"
                                    VerticalAlignment="Center" />

                    <atom:Button Grid.Column="5" Classes="tool"
                                 ButtonType="Text"
                                 Command="{Binding RefreshCommand}"
                                 atom:ToolTip.Tip="Refresh (F5)">
                        <controls:Icon Data="{Binding RefreshIcon}" Size="14" />
                    </atom:Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding Content}" />
        </Grid>
    </Grid>
</UserControl>
