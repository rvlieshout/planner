---
import notes from '../data/changelog.json';
import '../styles/global.css';

// Release notes are authored in src/data/changelog.json and rendered at build time, one entry per
// git tag. The page deliberately carries no product or company name: its readers already know where
// they are and only need the way in.
type Note = { version: string; title: string; date?: string; changes?: string[] };

const releases = (notes as Note[]).slice().sort((left, right) => {
  const a = left.version.split('.').map(Number), b = right.version.split('.').map(Number);
  return (b[0] - a[0]) || (b[1] - a[1]) || (b[2] - a[2]);
});

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC' }).format(new Date(value));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Sign in and release notes." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign in</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header>
        <img class="mark" src="/favicon.svg" width="24" height="24" alt="" />
        <nav aria-label="Main navigation">
          <a href="#changelog">Changelog</a>
          <a class="nav-open" href="/app">Open <span aria-hidden="true">→</span></a>
        </nav>
      </header>
      <main id="main">
        <section class="start" aria-labelledby="start-title">
          <h1 id="start-title">Sign in</h1>
          <ol class="steps">
            <li>
              <span class="n">1</span>
              <div>
                <h2>Open the app</h2>
                <p>Go to <a href="/app"><code>/app</code></a>. It runs in the browser; nothing to install.</p>
              </div>
            </li>
            <li>
              <span class="n">2</span>
              <div>
                <h2>Use your credentials</h2>
                <p>First time: choose <kbd>First-time setup or recovery</kbd> and enter the email and password you received.</p>
              </div>
            </li>
            <li>
              <span class="n">3</span>
              <div>
                <h2>Add a passkey</h2>
                <p>Follow the prompt after signing in. From then on, use <kbd>Sign in with a passkey</kbd>.</p>
              </div>
            </li>
          </ol>
          <a class="button" href="/app">Open the app <span aria-hidden="true">→</span></a>
          <p class="hint">Lost access? Ask your administrator for a password reset. No email is sent.</p>
        </section>

        <section class="changelog" id="changelog" aria-labelledby="changelog-title">
          <h2 id="changelog-title">Changelog</h2>
          {releases.length === 0 && <p class="empty">No releases yet.</p>}
          {releases.map((release, index) => (
            <article class="release">
              <div class="release-meta">
                <span class="version">v{release.version}</span>
                {index === 0 && <span class="latest">latest</span>}
                {release.date && <time datetime={release.date}>{formatDate(release.date)}</time>}
              </div>
              <div class="release-body">
                <h3>{release.title}</h3>
                {release.changes?.length
                  ? <ul>{release.changes.map(change => <li>{change}</li>)}</ul>
                  : <p class="empty">No notes for this version.</p>}
              </div>
            </article>
          ))}
        </section>
      </main>
      <footer><a href="#main">Top ↑</a></footer>
    </div>
  </body>
</html>
