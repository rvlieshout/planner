<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:projects="using:Planner.Contracts.Projects"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="560"
             x:Class="Planner.Client.Views.IssueEditorWindow"
             x:DataType="vm:IssueEditorViewModel"
             Icon="/Assets/planner.ico"
             Title="{Binding WindowTitle}"
             Width="560" Height="560"
             MinWidth="460" MinHeight="420"
             ShowInTaskbar="False"
             WindowStartupLocation="CenterOwner"
             LogoVisibility="Never"
             IsMinimizeCaptionButtonVisible="False">

    <atom:Window.Styles>
        <!-- Right-aligned label column, the way a native property sheet lines its fields up. -->
        <Style Selector="TextBlock.formLabel">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </atom:Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Identity strip: which team, and which issue. -->
        <Border Grid.Row="0"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding TeamName}" Classes="key" VerticalAlignment="Center" />
                <atom:Separator Orientation="Vertical" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Heading}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="12,12,14,12"
              ColumnDefinitions="72,*,72,*"
              RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
              RowSpacing="7" ColumnSpacing="0">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Classes="formLabel" />
            <atom:LineEdit Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding IssueTitle}"
                           PlaceholderText="Short summary of the work" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" Classes="formLabel"
                       VerticalAlignment="Top" Margin="0,4,8,0" />
            <!--
                IsAutoSize is what makes this a text area rather than a tall box with two editable lines
                in the middle of it. Left off, AtomUI pins the inner scroll viewer to exactly Lines
                (default 2) high and centres it in whatever space the control was given, so the frame
                stretches to fill the row while the text — and the caret — stay in a two-line band. On,
                the viewer follows the control, and the row's star height is the height of the field.
            -->
            <atom:TextArea Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           Text="{Binding Description}"
                           PlaceholderText="Optional detail"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           AcceptsTab="False"
                           IsAutoSize="True"
                           MinHeight="84"
                           VerticalContentAlignment="Top" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Classes="formLabel" />
            <atom:ComboBox Grid.Row="2" Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,10,0"
                           ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="contracts:WorkflowStateDto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Color, Converter={StaticResource HexBrush}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Priority:" Classes="formLabel" />
            <atom:ComboBox Grid.Row="2" Grid.Column="3"
                           HorizontalAlignment="Stretch"
                           ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PriorityOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Assignee:" Classes="formLabel" />
            <atom:ComboBox Grid.Row="3" Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,10,0"
                           ItemsSource="{Binding Assignees}"
                           SelectedItem="{Binding SelectedAssignee}"
                           PlaceholderText="Unassigned">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="contracts:TeamMemberDto">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="2" Text="Estimate:" Classes="formLabel" />
            <atom:NumericUpDown Grid.Row="3" Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                Value="{Binding Estimate}"
                                Minimum="0" Maximum="1000" Increment="1"
                                FormatString="0"
                                PlaceholderText="—" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Project:" Classes="formLabel" />
            <atom:ComboBox Grid.Row="4" Grid.Column="1"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,10,0"
                           ItemsSource="{Binding Projects}"
                           SelectedItem="{Binding SelectedProject}"
                           PlaceholderText="No project">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:ProjectDto">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Color, Converter={StaticResource HexBrush}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="2" Text="Milestone:" Classes="formLabel"
                       IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <atom:ComboBox Grid.Row="4" Grid.Column="3"
                           HorizontalAlignment="Stretch"
                           IsVisible="{Binding SelectedProject, Converter={x:Static ObjectConverters.IsNotNull}}"
                           ItemsSource="{Binding Milestones}"
                           SelectedItem="{Binding SelectedMilestone}"
                           PlaceholderText="No milestone">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:MilestoneDto">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Labels:" Classes="formLabel"
                       VerticalAlignment="Top" Margin="0,2,8,0"
                       IsVisible="{Binding HasLabels}" />

            <!-- A label is picked, not typed, and the tag that shows it on a card is the same shape as
                 the one that toggles it here — which is the whole reason to use AtomUI's checkable tag
                 rather than a toggle button dressed up to look like one.

                 The colours are set locally so that they survive being checked: the theme paints the
                 checked state through a selector, and a local value outranks one. -->
            <ItemsControl Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                          ItemsSource="{Binding Labels}"
                          IsVisible="{Binding HasLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabelChipViewModel">
                        <atom:CheckableTag Content="{Binding Name}"
                                           IsChecked="{Binding IsSelected}"
                                           Background="{Binding ChipBackground, Converter={StaticResource HexBrush}}"
                                           BorderBrush="{Binding Color, Converter={StaticResource HexBrush}}"
                                           Foreground="{Binding ChipForeground, Converter={StaticResource HexBrush}}"
                                           Margin="0,0,4,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Command area. Buttons bottom-right, destructive action kept far away on the left. -->
        <Border Grid.Row="2"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,1,0,0"
                Padding="12,9">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="7">
                <atom:Button Grid.Column="0" Content="Archive"
                             IsDanger="True"
                             Command="{Binding ArchiveCommand}"
                             IsVisible="{Binding IsEditing}"
                             IsEnabled="{Binding !IsBusy}"
                             MinWidth="80"
                             HorizontalContentAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="8,0"
                           FontSize="{atom:SharedTokenResource FontSizeSM}"
                           Foreground="{atom:SharedTokenResource ColorError}" />

                <atom:Button Grid.Column="2"
                             ButtonType="Primary"
                             Command="{Binding SubmitCommand}"
                             IsLoading="{Binding IsBusy}"
                             IsEnabled="{Binding !IsBusy}"
                             IsDefault="True"
                             MinWidth="84"
                             HorizontalContentAlignment="Center">
                    <TextBlock Text="{Binding SubmitLabel}" />
                </atom:Button>

                <atom:Button Grid.Column="3" Content="Cancel"
                             Command="{Binding CancelCommand}"
                             IsEnabled="{Binding !IsBusy}"
                             IsCancel="True"
                             MinWidth="84"
                             HorizontalContentAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</atom:Window>
