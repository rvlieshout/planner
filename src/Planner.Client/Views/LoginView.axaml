<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Planner.Client.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- A connection dialog, not a landing page: one card of fields, labels in their own column, and
         the default button bottom-right. -->
    <atom:Card Width="340"
               Header="Sign in to Planner"
               HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="9">
            <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <atom:LineEdit Grid.Row="0" Grid.Column="1"
                               Text="{Binding ServerUrl}"
                               PlaceholderText="http://planner.internal:8080"
                               IsEnabled="{Binding !IsBusy}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <atom:LineEdit Grid.Row="1" Grid.Column="1"
                               Text="{Binding Email}"
                               PlaceholderText="you@company.local"
                               IsEnabled="{Binding !IsBusy}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" Classes="field"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                <atom:LineEdit Grid.Row="2" Grid.Column="1"
                               Text="{Binding Password}"
                               PasswordChar="●"
                               IsEnableRevealButton="True"
                               IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <atom:Separator />

            <Grid ColumnDefinitions="*,Auto">
                <atom:Button Grid.Column="1"
                             Content="Sign in"
                             ButtonType="Primary"
                             Command="{Binding SignInCommand}"
                             IsLoading="{Binding IsBusy}"
                             IsEnabled="{Binding !IsBusy}"
                             IsDefault="True"
                             MinWidth="84"
                             HorizontalContentAlignment="Center" />
            </Grid>

            <StackPanel Spacing="4"
                        IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                <atom:Alert Type="Error" Message="{Binding Error}" />

                <!-- The reason the update banner is not gated on being signed in: if this version is
                     the problem, this hint is the only route out of it. -->
                <TextBlock IsVisible="{Binding ShowUpdateHint}"
                           Text="An update is ready to install. If sign-in stopped working after an upgrade, installing it may fix this."
                           TextWrapping="Wrap"
                           Classes="caption" />
            </StackPanel>
        </StackPanel>
    </atom:Card>
</UserControl>
