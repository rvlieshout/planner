<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="Planner.Client.App"
             xmlns:local="using:Planner.Client"
             xmlns:converters="using:Planner.Client.Converters"
             xmlns:controls="using:Planner.Client.Controls"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!--
        There is no theme element here.

        AtomUI's control themes are registered from code, in App.Initialize, because the token snapshot
        they read has to be compiled before the first control is realised. That file — not this one — is
        where the palette, the density and the two variants are decided; everything below only says how
        this app arranges what AtomUI already draws.

        The consequence worth knowing: AtomUI themes AtomUI's own control types. A bare Avalonia Button
        or TextBox in a view has no theme at all and renders as an unstyled box, so the views use the
        `atom:` controls throughout.
    -->
    <Application.Styles>

        <!--
            Ant Design's own text control, wired to the token palette. TextBlock is used in far more
            places than any other control here, and the alternative is repeating a Foreground binding on
            every one of them.
        -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>

        <!-- Toolbar buttons: flat until pointed at, the way a native toolstrip behaves. AtomUI's Text
             button type is exactly that, so this only has to hold the metrics. -->
        <Style Selector="atom|Button.tool">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="22" />
        </Style>

        <!-- Caption strip buttons sit on the title bar, so they are square and quiet. -->
        <Style Selector="atom|Button.caption">
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- An icon inside a quiet button follows the button's own text colour rather than shouting in
             full-strength foreground. -->
        <Style Selector="atom|Button.tool controls|Icon, atom|Button.caption controls|Icon">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
        </Style>

        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
        </Style>

        <!-- Section captions in the sidebar and the form. Small and grey rather than bold: they label
             a group without competing with the content inside it. -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
        </Style>

        <!-- Issue keys are identifiers, not prose: aligned digits make a column of them scannable. -->
        <Style Selector="TextBlock.key">
            <Setter Property="FontFamily" Value="{DynamicResource AppMonoFontFamily}" />
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
        </Style>

        <!-- One-pixel rules do the work a card outline was doing. -->
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorSplit}" />
        </Style>

        <!--
            Dense rows.

            AtomUI's list item is sized for a menu — token padding, a minimum height, a rounded
            selection pill. A board card and a table row bring their own box, so the item is reduced to
            the rectangle around it. These are Styles rather than a replacement ControlTheme on purpose:
            a Style outranks a ControlTheme setter, so the theme keeps supplying the hover and selection
            visuals and only the metrics are overridden.
        -->
        <Style Selector="atom|ListBox.dense">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsBorderless" Value="True" />
            <Setter Property="Padding" Value="0" />
            <!-- AtomUI draws an illustrated "No data" placeholder in an empty list. Each of these lists is
                 one column or one group among several, and the view already says once, in the middle of
                 the screen, that there is nothing to show — so repeating it per column is noise, and it
                 is noise sitting exactly where a drop indicator needs to be legible. -->
            <Setter Property="IsShowEmptyIndicator" Value="False" />
        </Style>
        <Style Selector="atom|ListBox.dense atom|ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- A card row carries its own bordered box, so the row it sits in must not paint one as well;
             the card handles the drag states itself. -->
        <Style Selector="atom|ListBox.cards atom|ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--
            Access keys in menus.

            AtomUI's menu item template runs the header through a converter that wraps a string in a
            TextBlock before the ContentPresenter sees it. RecognizesAccessKey only fires for string
            content, so the wrapper defeats it: "E_xit" is drawn with the underscore in it and Alt+X
            does nothing. Handing the presenter the raw header back restores the AccessText the rest of
            the framework — and every other menu on this platform — expects.

            Top level items are unaffected: their template binds Header straight through, which is why
            this only touches the part named in the popup template. Drop this once AtomUI stops
            converting.
        -->
        <Style Selector="atom|MenuItem:not(:toplevel) /template/ ContentPresenter#ItemTextPresenter">
            <Setter Property="Content" Value="{Binding $parent[atom:MenuItem].Header}" />
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Planner.Client/Assets/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:HexBrushConverter x:Key="HexBrush" />

            <!-- The one font AtomUI has no token for: issue keys need fixed advance widths. -->
            <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
