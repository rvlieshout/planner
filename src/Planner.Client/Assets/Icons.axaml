<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Lucide icons (https://lucide.dev), ISC licensed, from lucide-static 1.35.0.

        The published Lucide.Avalonia package targets Avalonia 11 and this client is on 12, so the
        handful of icons actually used are embedded as geometry instead. Each is the original 24x24
        stroke path with its sub-paths concatenated; nothing is redrawn by hand.

        To add one: take the <path> data from the Lucide SVG, and if it starts with a relative "m",
        write it as "M{x},{y} l{rest}" — a leading relative moveto is absolute in SVG, but not once
        it follows another sub-path in the same geometry.
    -->

    <StreamGeometry x:Key="IconCalendar">M8 2v3 M16 2v3 M5,3h14a2,2 0 0,1 2,2v14a2,2 0 0,1 -2,2h-14a2,2 0 0,1 -2,-2v-14a2,2 0 0,1 2,-2z M3 9h18</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M20 6 9 17l-5-5</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M6,9 l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9,18 l6-6-6-6</StreamGeometry>
    <StreamGeometry x:Key="IconCircleArrowUp">M2,12a10,10 0 1,0 20,0a10,10 0 1,0 -20,0 M16,12 l-4-4-4 4 M12 16V8</StreamGeometry>
    <StreamGeometry x:Key="IconCircleUser">M2,12a10,10 0 1,0 20,0a10,10 0 1,0 -20,0 M9,10a3,3 0 1,0 6,0a3,3 0 1,0 -6,0 M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662</StreamGeometry>
    <StreamGeometry x:Key="IconFolderKanban">M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z M8 10v4 M12 10v2 M16 10v6</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>
    <StreamGeometry x:Key="IconInbox">M22,12 L16,12 L14,15 L10,15 L8,12 L2,12 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z</StreamGeometry>
    <StreamGeometry x:Key="IconLayoutGrid">M4,3h5a1,1 0 0,1 1,1v5a1,1 0 0,1 -1,1h-5a1,1 0 0,1 -1,-1v-5a1,1 0 0,1 1,-1z M15,3h5a1,1 0 0,1 1,1v5a1,1 0 0,1 -1,1h-5a1,1 0 0,1 -1,-1v-5a1,1 0 0,1 1,-1z M15,14h5a1,1 0 0,1 1,1v5a1,1 0 0,1 -1,1h-5a1,1 0 0,1 -1,-1v-5a1,1 0 0,1 1,-1z M4,14h5a1,1 0 0,1 1,1v5a1,1 0 0,1 -1,1h-5a1,1 0 0,1 -1,-1v-5a1,1 0 0,1 1,-1z</StreamGeometry>
    <StreamGeometry x:Key="IconLogOut">M16,17 l5-5-5-5 M21 12H9 M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4</StreamGeometry>
    <StreamGeometry x:Key="IconMenu">M4 5h16 M4 12h16 M4 19h16</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M5 12h14 M12 5v14</StreamGeometry>
    <StreamGeometry x:Key="IconRefreshCw">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</StreamGeometry>
