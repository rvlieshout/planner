<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200"
             x:Class="Planner.Client.Views.UpdateBannerView"
             x:DataType="vm:UpdateBannerViewModel"
             IsVisible="{Binding IsVisible}">

    <!-- An info bar, the way an editor reports something the user should act on: one line, full width,
         action on the right. Not a hero panel. -->
    <Border Background="{DynamicResource AccentBrush}" Padding="9,4" MinHeight="28">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">

            <controls:Icon Grid.Column="0"
                           Data="{Binding UpdateIcon}"
                           Size="14"
                           Foreground="White"
                           VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Headline}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="White" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Detail}"
                       IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="#DDFFFFFF" />

            <ProgressBar Grid.Column="3"
                         Value="{Binding PercentComplete}"
                         Maximum="100"
                         Width="120"
                         Height="2"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !CanRestart}" />

            <Button Grid.Column="4"
                    Content="Restart and install"
                    Command="{Binding RestartAndInstallCommand}"
                    IsVisible="{Binding CanRestart}"
                    IsEnabled="{Binding !IsBusy}"
                    VerticalAlignment="Center"
                    MinHeight="20"
                    Padding="9,1"
                    Background="White"
                    BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}" />
        </Grid>
    </Border>
</UserControl>
