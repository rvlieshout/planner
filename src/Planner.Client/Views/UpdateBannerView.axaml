<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200"
             x:Class="Planner.Client.Views.UpdateBannerView"
             x:DataType="vm:UpdateBannerViewModel"
             IsVisible="{Binding IsVisible}">

    <!-- An info bar, the way an editor reports something the user should act on: one line, full width,
         action on the right. Not a hero panel. -->
    <Border Background="{atom:SharedTokenResource ColorInfoBg}"
            BorderBrush="{atom:SharedTokenResource ColorInfoBorder}"
            BorderThickness="0,0,0,1"
            Padding="9,4"
            MinHeight="28">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">

            <controls:Icon Grid.Column="0"
                           Data="{Binding UpdateIcon}"
                           Size="14"
                           Foreground="{atom:SharedTokenResource ColorInfo}"
                           VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Headline}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Detail}"
                       IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Classes="caption"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <atom:ProgressBar Grid.Column="3"
                              Value="{Binding PercentComplete}"
                              Maximum="100"
                              Width="120"
                              IsProgressInfoVisible="False"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !CanRestart}" />

            <atom:Button Grid.Column="4"
                         Content="Restart and install"
                         ButtonType="Primary"
                         SizeType="Small"
                         Command="{Binding RestartAndInstallCommand}"
                         IsVisible="{Binding CanRestart}"
                         IsEnabled="{Binding !IsBusy}"
                         VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
