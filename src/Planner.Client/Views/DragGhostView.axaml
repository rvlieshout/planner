<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:controls="using:Planner.Client.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Planner.Client.Views.DragGhostView"
             x:DataType="vm:IssueCardViewModel"
             IsHitTestVisible="False">

    <!--
        The issue in the user's hand.

        A platform drag owns the cursor, so the only thing an app can put underneath it is something it
        draws itself. This is the board card reduced to what stays legible at cursor speed: the
        identifier, the priority, and as much of the title as fits.

        Elevated rather than flat, and outlined in the primary colour — the same colour the column it is
        heading for lights up in, so the two read as one gesture.
    -->
    <Border Background="{atom:SharedTokenResource ColorBgElevated}"
            BorderBrush="{atom:SharedTokenResource ColorPrimaryBorder}"
            BorderThickness="1"
            CornerRadius="{atom:SharedTokenResource BorderRadius}"
            BoxShadow="{atom:SharedTokenResource BoxShadowsSecondary}"
            Padding="7,4"
            Opacity="0.96">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding Key}" Classes="key" VerticalAlignment="Center" />

            <controls:Icon Data="{Binding PriorityIcon}"
                           Size="13"
                           IsVisible="{Binding HasPriority}"
                           VerticalAlignment="Center"
                           Foreground="{Binding PriorityColor, Converter={StaticResource HexBrush}}" />

            <TextBlock Text="{Binding Title}"
                       MaxWidth="220"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
