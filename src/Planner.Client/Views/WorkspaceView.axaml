<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Planner.Client.ViewModels"
             xmlns:contracts="using:Planner.Contracts.Teams"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Planner.Client.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="20,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="14">

                <TextBlock Grid.Column="0"
                           Text="Planner"
                           FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppForeground}" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Teams}"
                          SelectedItem="{Binding SelectedTeam}"
                          MinWidth="220"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="contracts:TeamDto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{Binding Color, Converter={StaticResource HexBrush}}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource MutedForeground}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                            Background="{Binding LiveColor, Converter={StaticResource HexBrush}}" />
                    <TextBlock Text="{Binding LiveText}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedForeground}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource AppForeground}" />
                        <TextBlock Text="{Binding UserRole}" FontSize="11"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedForeground}" />
                    </StackPanel>
                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Board -->
        <Panel Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Columns}" Margin="20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BoardColumnViewModel">
                            <Border Width="290"
                                    Background="{DynamicResource ColumnBackground}"
                                    CornerRadius="10"
                                    Padding="12">
                                <Grid RowDefinitions="Auto,*">

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                                Margin="4,2,4,12">
                                        <Border Width="9" Height="9" CornerRadius="5"
                                                Background="{Binding Color, Converter={StaticResource HexBrush}}"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppForeground}" />
                                        <TextBlock Text="{Binding Count}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedForeground}" />
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IssueCardViewModel">
                                                    <Border Background="{DynamicResource CardBackground}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Spacing="8">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Key}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource MutedForeground}" />
                                                                <TextBlock Text="{Binding PriorityLabel}"
                                                                           IsVisible="{Binding HasPriority}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding PriorityColor, Converter={StaticResource HexBrush}}" />
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Title}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource AppForeground}" />

                                                            <ItemsControl ItemsSource="{Binding Labels}"
                                                                          IsVisible="{Binding HasLabels}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="contracts:LabelDto">
                                                                        <Border BorderBrush="{Binding Color, Converter={StaticResource HexBrush}}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10"
                                                                                Padding="7,2"
                                                                                Margin="0,0,4,0">
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="10"
                                                                                       Foreground="{Binding Color, Converter={StaticResource HexBrush}}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border HorizontalAlignment="Right"
                                                                    IsVisible="{Binding AssigneeInitials, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                    Width="22" Height="22" CornerRadius="11"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    ToolTip.Tip="{Binding AssigneeName}">
                                                                <TextBlock Text="{Binding AssigneeInitials}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         VerticalAlignment="Top"
                         Height="3" />

            <Border IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="20"
                    Background="#1AEB5757"
                    BorderBrush="#4DEB5757"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="#EB5757" />
            </Border>
        </Panel>
    </Grid>
</UserControl>
